# --- Server ---
PORT=8787
PUBLIC_URL=http://localhost:8787
DB_PATH=./data/anchor.db

# --- Stellar (testnet) ---
# live = talk to Horizon testnet. fake = in-memory Stellar (unit tests / offline dev).
STELLAR_MODE=live
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Circle's testnet USDC issuer (default). Override to point at a self-issued mock asset.
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Treasury account: holds the USDC that on-ramps pay out and receives off-ramp deposits.
# Create one with: npm run setup:treasury
TREASURY_SECRET=

# --- Pricing ---
# reflector = read USD/TRY from Reflector's FX oracle on Stellar mainnet (falls back to static on error).
# static    = always use STATIC_USDTRY.
RATE_SOURCE=reflector
STATIC_USDTRY=47.50
SPREAD_BPS=50
QUOTE_TTL_SECONDS=120
OFFRAMP_RATE_LOCK_SECONDS=1800

# --- Limits ---
MIN_ONRAMP_TRY=50.00
MAX_ONRAMP_TRY=250000.00
MIN_OFFRAMP_USDC=1.0000000

# --- Mock bank identity shown in deposit instructions ---
BANK_NAME=TR Mock Bank A.Ş.
ACCOUNT_HOLDER=TR Mock Anchor Teknoloji A.Ş.

# --- Workers (settlement loops). Set false to run API only. ---
WORKERS=true
